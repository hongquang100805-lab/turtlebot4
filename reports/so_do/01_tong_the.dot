digraph G {

  graph [bgcolor="white", rankdir=TB, nodesep=0.40, ranksep=0.55, pad=0.18, dpi=180];
  node [shape=box, style="rounded,filled", fillcolor="#EDF2FA", color="#506580", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#40516A", arrowsize=0.8, penwidth=1.15];

  robot [label="Gazebo Harmonic + TurtleBot 4
Cảm biến, odometry và controller", fillcolor="#E5F2E8"];
  subgraph cluster_mapping {
    label=""; fontname="DejaVu Sans"; fontsize=12; color="#98AEC6"; style="rounded";
    slam [label="SLAM Toolbox
Tạo /map và TF map → odom"];
    save [label="Map Saver
Lưu YAML + PGM", fillcolor="#FFF0D6"];
    slam -> save [label="/map"];
  }
  subgraph cluster_navigation {
    label=""; fontname="DejaVu Sans"; fontsize=12; color="#98AEC6"; style="rounded";
    local [label="Map Server + AMCL
Nạp bản đồ và định vị"];
    nav [label="Nav2
Lập kế hoạch và điều khiển"];
    local -> nav [label="/map, pose và TF"];
  }
  robot -> slam [label="/scan và TF odometry"];
  save -> local [label="Bản đồ đã lưu"];
  robot -> local [label="/scan, TF
của phiên mới", constraint=false];
  nav -> robot [label="Luồng vận tốc → /cmd_vel
TwistStamped", constraint=false];

}
