digraph G {

  graph [bgcolor="white", rankdir=TB, nodesep=0.40, ranksep=0.55, pad=0.18, dpi=180];
  node [shape=box, style="rounded,filled", fillcolor="#EDF2FA", color="#506580", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#40516A", arrowsize=0.8, penwidth=1.15];

  goal [label="RViz: Nav2 Goal
Chọn vị trí và hướng đích", fillcolor="#FFF0D6"];
  bt [label="BT Navigator
Quản lý tiến trình goal"];
  planner [label="Planner Server
Global costmap → đường đi"];
  controller [label="Controller Server
Path + local costmap + trạng thái robot"];
  smooth [label="Velocity Smoother"];
  collision [label="Collision Monitor"];
  motion [label="Motion Control
+ Diffdrive Controller"];
  robot [label="Gazebo bridge → TurtleBot 4
Robot tự di chuyển", fillcolor="#E5F2E8"];
  goal -> bt [label="Action\n/navigate_to_pose"];
  bt -> planner [label="Yêu cầu lập kế hoạch"];
  planner -> controller [label="Đường đi"];
  bt -> controller [label="Điều phối theo path", constraint=false];
  controller -> smooth [label="/cmd_vel_nav"];
  smooth -> collision [label="/cmd_vel_smoothed"];
  collision -> motion [label="/cmd_vel (TwistStamped)"];
  motion -> robot [label="/diffdrive_controller/cmd_vel"];
  bt -> goal [label="Feedback\nvà trạng thái cuối", style=dashed, constraint=false];

}
