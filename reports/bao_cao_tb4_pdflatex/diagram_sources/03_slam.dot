digraph G {

  graph [bgcolor="white", rankdir=TB, nodesep=0.40, ranksep=0.55, pad=0.18, dpi=180];
  node [shape=box, style="rounded,filled", fillcolor="#EDF2FA", color="#506580", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#40516A", arrowsize=0.8, penwidth=1.15];

  scan [label="LiDAR
/scan", fillcolor="#E5F2E8"];
  tf [label="TF odometry
odom → base_link
và TF tới LiDAR", fillcolor="#E5F2E8"];
  {rank=same; scan; tf;}
  slam [label="SLAM Toolbox
Đối sánh scan · Pose graph
Loop closure"];
  map [label="Occupancy Grid
/map"];
  outtf [label="TF
map → odom"];
  {rank=same; map; outtf;}
  saver [label="Nav2 Map Saver
Script save_map.sh", fillcolor="#FFF0D6"];
  files [label="Bản đồ lưu
*.yaml + *.pgm", fillcolor="#FFF0D6"];
  scan -> slam; tf -> slam;
  slam -> map; slam -> outtf;
  map -> saver; saver -> files;

}
