digraph G {

  graph [bgcolor="white", rankdir=TB, nodesep=0.40, ranksep=0.55, pad=0.18, dpi=180];
  node [shape=box, style="rounded,filled", fillcolor="#EDF2FA", color="#506580", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#40516A", arrowsize=0.8, penwidth=1.15];

  files [label="Bản đồ đã tạo
YAML + PGM", fillcolor="#FFF0D6"];
  server [label="Map Server"];
  sensor [label="Robot mô phỏng
/scan và TF odometry", fillcolor="#E5F2E8"];
  initial [label="RViz: 2D Pose Estimate
Ước lượng vị trí hiện tại", fillcolor="#FFF0D6"];
  amcl [label="AMCL
Ước lượng pose bằng bộ lọc hạt"];
  pose [label="/amcl_pose"];
  tf [label="TF
map → odom"];
  view [label="RViz + đối chiếu Gazebo
Kiểm tra LiDAR khớp map", fillcolor="#E5F2E8"];
  files -> server;
  server -> amcl [label="/map"];
  sensor -> amcl; initial -> amcl [label="/initialpose"];
  amcl -> pose; amcl -> tf;
  pose -> view; tf -> view;

}
